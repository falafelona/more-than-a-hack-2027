# -----------------------------------------------------------------------------------------------
# This repository is submitted publicly. Match data lives outside it ($MTAH_DATA_DIR, docs/decisions.md D1).
# The patterns below are a backstop in case someone puts data here by habit.
# -----------------------------------------------------------------------------------------------

# -- match data and anything derived from it -----------------------------------------------------
data/
cache/
*.mp4
*.mov
*.gzip
*.pl3container
*_atd.txt
*_atd.xml
*_smart_tagging.xml
*_homography.csv
*_possession_gt*.csv
possession_by_frame.pkl
*.pkl
*.npz
*.npy
*.parquet
*.feather
*.h5

# -- outputs: submission files are frame-level labels ---------------------------------------------
outputs/*
!outputs/.gitkeep
*.csv
!experiments/**/*.csv

# -- documents: the technical doc is committed as Markdown, never as an exported PDF -------------
*.pdf

# -- environments, editors, build artifacts ------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
.claude/settings.local.json
